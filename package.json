{
  "name": "@pvogel/nestjs-auth",
  "version": "0.10.0",
  "description": "Maintained fork of @eropple/nestjs-auth: authentication and rights-tree authorization for NestJS 10+.",
  "author": "Peter Vogel",
  "contributors": [
    "Ed Ropple"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pvogel1967/nestjs-auth.git"
  },
  "private": false,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint .",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/write-dist-package-json.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "pnpm build && node scripts/check-readme-snippets.mjs && node --test \"test/*.test.{cjs,mjs}\"",
    "check:exports": "pnpm build && attw --pack .",
    "prepare": "pnpm lint && pnpm build",
    "test:matrix": "node scripts/test-matrix.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@types/express": "^4.17.0 || ^5.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    }
  },
  "dependencies": {
    "cookie": "^1.1.1",
    "nanomatch": "^1.2.13"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-fastify": "^10.4.22",
    "@types/bunyan": "^1.8.11",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bunyan": "^1.8.15",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pino": "^10.0.0",
    "prettier": "^1.18.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "winston": "^3.17.0"
  },
  "bugs": {
    "url": "https://github.com/pvogel1967/nestjs-auth/issues"
  },
  "homepage": "https://github.com/pvogel1967/nestjs-auth#readme"
}
